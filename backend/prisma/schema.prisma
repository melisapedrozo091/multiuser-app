generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String?
  displayName      String?
  role             String    @default("CLIENTE")
  resetCode        String?
  resetCodeExpires DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  products         Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  syllabus    String?  @db.Text
  price       Float
  stock       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
}

model ChatMessage {
  id         String   @id @default(cuid())
  senderUid  String
  senderName String
  message    String   @db.Text
  timestamp  DateTime @default(now())
}

model Enrollment {
  id            String    @id @default(cuid())
  code          String    @unique
  userId        String
  userEmail     String
  userName      String
  courseId      Int
  courseName    String
  price         Float
  currency      String    @default("USD")
  date          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  pausedAt      DateTime?
  status        String    @default("INSCRIPTO")
  paymentMethod String
  refundReason  String?
  rating        Int?
  reviewComment String?   @db.Text
  deletedFromUi Boolean   @default(false)
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  enrollmentId  String?
  userId        String
  userEmail     String
  clientName    String
  courseName    String
  amount        Float
  currency      String   @default("USD")
  paymentMethod String
  date          String
  status        String   @default("PAGADO")
  createdAt     DateTime @default(now())
}

model Certificate {
  id              String   @id @default(cuid())
  certificateCode String   @unique
  enrollmentId    String?
  userId          String
  userEmail       String
  studentName     String
  courseName      String
  issueDate       String
  grade           String   @default("Sobresaliente (10/10)")
  status          String   @default("EMITIDO")
  createdAt       DateTime @default(now())
}

model CourseReview {
  id         String   @id @default(cuid())
  courseId   Int
  courseName String
  userId     String
  userEmail  String
  userName   String
  rating     Int
  comment    String   @db.Text
  createdAt  DateTime @default(now())
}
